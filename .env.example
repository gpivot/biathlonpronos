# Copier ce fichier en .env.local et renseigner les valeurs depuis
# Supabase > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé service_role — usage serveur uniquement (jamais exposée au client),
# nécessaire pour les opérations admin (saisie de résultats, back-office).
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notifications de l'appli Android / iOS : contenu complet du fichier JSON du compte de service
# Firebase (Paramètres du projet > Comptes de service > Générer une nouvelle clé privée), sur une
# seule ligne. Usage serveur uniquement.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# E-mails de notification (rappels, récap du lundi, nouvelles) envoyés par Resend : clé API
# « Sending access » (Resend > API Keys). Voir docs/notifications.md.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Facultatif : expéditeur, sur le domaine vérifié dans Resend.
# EMAIL_FROM=Biathlonpronos <notifications@biathlonpronos.fr>

# Mot de passe de l'appel planifié /api/notifications/cron (pg_cron de Supabase, tous les 15 min).
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
